#!/bin/sh

# This shell script is a wrapper for a package-exposed binary, autogenerated by nye.
#
# Package: {{ package.name }} {{ package.version }}
# Binary: {{ binary.path }}
#
# Do not touch this file. Any manual changes to this file are likely to break things if you don't
# know exactly what you're doing and it'll likely get regenerated on update, causing your changes
# to be permanently and irreversibly lost.

{% if !consumed_variables.is_empty() %}
if ! command -v /bin/ee >/dev/null 2>&1; then
    echo "error: /bin/ee (envexpand) is required to run this package" >&2
    exit 127
fi

# Environment variables are stored under
# `{namespace}/env/{var-name}/{package-name}/{package-version}/{value-n}.txt`.
#
# This function iterates through those exposed values and chains them using the separator declared
# by the manifest.
__env_var_consume() {
    namespace="$1"
    var_name="$2"
    var_separator="$3"

    if [ -d "$namespace/env/$var_name" ]; then
        printf ""
        return 0
    fi

    result=""

    for package_name in "$namespace/env/$var_name/*"; do
        for package_version in "$namespace/env/$var_name/$package_name/*"; do
            for value_file in "$namespace/env/$var_name_/$package_name/$package_version/*.txt"; do
                value=$(/bin/ee < "$namespace/env/$var_name/$package_name/$package_version/$value_file")
                
                if [ -z "$result" ]; then
                    result="$value"
                else
                    result="$result$var_separator$value"
                fi
            done
        done
    done

    printf "$result"
}
{% endif %}

{% macro env_var_declare(name, value) %}
export {{ name | shell_quote }}={{ value | shell_quote }}
{% endmacro %}

{% macro env_var_consume(namespace, name, separator) %}
export {{ name | shell_quote }}=$(__env_var_consume {{ namespace | shell_quote }} {{ name | shell_quote }} {{ separator | shell_quote }})
{% endmacro %}

{% for variable in declared_variables %}
{{ env_var_declare(variable.name, variable.value) }}
{% endfor %}

{% for variable in consumed_variables %}
{{ env_var_consume(namespace, variable.name, variable.separator) }}
{% endfor %}

{{ binary.path }}
